<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Merged into the tool APK (single-APK build, 2026-08-19). Rung 1:
         open-only sync — no FGS, no boot receiver, no push, no notifications,
         no server-hosted activities; the library contributes only the
         bootstrap provider and the basic permissions. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Media downloads are gated on the connection type (Settings toggle). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- sdk:ui merges CAMERA for its QR scanner; this is a chat server. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <!-- The tool's generated manifest provides the application class
         (LightSdkApplication), label, and theme; the library contributes only
         components + attributes that don't conflict (cleartext HTTP so a
         self-hosted LAN homeserver, e.g. 10.0.2.2 in dev, works; large heap for
         the Trixnity Room store). -->
    <application
        android:usesCleartextTraffic="true"
        android:largeHeap="true">

        <!-- Wires the SDK server (cert check) and initializes MatrixRepository
             (session restore + the open-only sync lifecycle driver) at process
             start, before the tool starts. -->
        <provider
            android:name=".ServerBootstrapProvider"
            android:authorities="com.lightphone.chats.server.bootstrap"
            android:exported="false" />

        <!-- sdk:client merges its UnifiedPush service + file-share provider;
             chats is a local Matrix client and uses neither. -->
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            tools:node="remove" />
        <provider
            android:name="com.thelightphone.sdk.LightFileProvider"
            tools:node="remove" />

        <!-- sdk:server merges the UnifiedPush distributor (an EXPORTED receiver —
             any app can start the process with it); chats delivers messages via
             its own in-tool sync loop, so strip it. -->
        <receiver
            android:name="com.thelightphone.sdk.server.LightPushDistributor"
            tools:node="remove" />
    </application>

</manifest>
