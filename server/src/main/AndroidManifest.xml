<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Merged into the tool APK (single-APK build, 2026-08-19): the former
         companion is a library whose manifest contributes the persistent
         Matrix connection (sync loop, storage, notifications) — everything the
         tool runtime forbids — as components + permissions in the same APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Media downloads are gated on the connection type (Settings toggle). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice notes are recorded in the server library (RECORD_AUDIO is granted
         at runtime by VoiceNoteActivity). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Photo attach fallback (2026-08-19 feedback round): devices without a
         system photo picker (the LP3's stripped firmware) fall back to an
         in-app gallery over DCIM/Pictures; granted at runtime by
         PhotoSendActivity. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- sdk:ui merges CAMERA for its QR scanner; this is a chat server. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <!-- ACTION_DIAL visibility (Android 11+): the server opens the dialer
         prefilled from the contact panel CALL icon; without this the implicit
         intent can't resolve (AppsFilter blocks chats -> dialer on the LP3). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!-- The tool's generated manifest provides the application class
         (LightSdkApplication), label, and theme; the library contributes only
         components + attributes that don't conflict (cleartext HTTP so a
         self-hosted LAN homeserver, e.g. 10.0.2.2 in dev, works; large heap for
         the Trixnity Room store). -->
    <application
        android:usesCleartextTraffic="true"
        android:largeHeap="true">

        <!-- Wires the SDK server (settings, cert check, chat methods) and
             initializes MatrixRepository (session restore + sync service) at
             process start, before the tool's first binder call. -->
        <provider
            android:name=".ServerBootstrapProvider"
            android:authorities="com.lightphone.chats.server.bootstrap"
            android:exported="false" />

        <!-- Shows the system photo picker and sends the chosen photo; started
             by the tool via StartPhotoSend + startServerActivity (the tool
             runtime forbids startActivity, the server can't launch activities
             from the background). -->
        <activity
            android:name=".PhotoSendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Requests POST_NOTIFICATIONS at runtime — declaring it in the
             manifest is not enough on targetSdk 33+ (it stays denied until
             requested, so message notifications were silently blocked on
             fresh installs). Started by the tool from the chat list via
             startServerActivity; finishes immediately once granted. -->
        <activity
            android:name=".NotificationPermissionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Records a voice note (AAC/m4a) and sends it as an m.audio message;
             started by the tool via StartVoiceNoteSend + startServerActivity. -->
        <activity
            android:name=".VoiceNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Dev control surface (2026-08-21, re-added): drives the push channel
             from adb via launch extras (pushsse/pushnotify/pushkey overrides,
             pushclear cleanup, debugLog, scripted login/send — see
             chats/push/README.md). Exported so adb shell can start it; the
             tool is the launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- AOSP runtime-permission host for the SDK permission flow (the tool
             requests POST_NOTIFICATIONS through it; see ChatsPermissionActivity).
             Translucent so the system dialog is the only thing visible. -->
        <activity
            android:name=".ChatsPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Keeps the Matrix sync loop alive in the background. Uses cleartext
             HTTP so a self-hosted LAN homeserver (e.g. 10.0.2.2 in dev) works. -->
        <service
            android:name=".ChatSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Dev probe (2026-08-21): receives the endpoint LightOS's UP
             distributor issues for the "light-push" instance (see
             ServerBootstrapProvider). Removed with the probe. -->
        <service
            android:name=".UpProbeService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT"/>
            </intent-filter>
        </service>

        <!-- sdk:client merges its UnifiedPush service + file-share provider;
             chats is a local Matrix client and uses neither. -->
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            tools:node="remove" />
        <provider
            android:name="com.thelightphone.sdk.LightFileProvider"
            tools:node="remove" />

        <!-- sdk:server merges the UnifiedPush distributor (an EXPORTED receiver —
             any app can start the process with it) and the connector's
             receiver/activity/foreground service; chats delivers messages via
             its own sync loop, so strip them all. (MessagingReceiverImpl is
             un-stripped while the UP probe is active — the distributor's
             NEW_ENDPOINT reply needs it; the connector's own receiver is not
             exported, so no exposure.) -->
        <receiver
            android:name="com.thelightphone.sdk.server.LightPushDistributor"
            tools:node="remove" />
        <activity
            android:name="org.unifiedpush.android.connector.internal.LinkActivity"
            tools:node="remove" />
        <service
            android:name="org.unifiedpush.android.connector.internal.RaiseToForegroundService"
            tools:node="remove" />
    </application>

</manifest>
