<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The companion holds the persistent Matrix connection (Phase 2) and posts
         new-message notifications; everything the tool runtime forbids. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Media downloads are gated on the connection type (Settings toggle). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice notes are recorded in the companion (the tool runtime forbids
         media APIs; RECORD_AUDIO is granted at runtime by VoiceNoteActivity). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- sdk:ui merges CAMERA for its QR scanner; the companion is a chat server. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <application
        android:name=".ServerApplication"
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="Chats Server"
        android:theme="@android:style/Theme.Black.NoTitleBar"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true">

        <!-- MainActivity (the dev status/control screen with scripted login/send
             extras) is declared in src/debug/AndroidManifest.xml only — the
             release companion is a service-only app. -->

        <!-- Shows the system photo picker and sends the chosen photo; started
             by the tool via StartPhotoSend + startServerActivity (the tool
             runtime forbids startActivity, the companion can't launch
             activities from the background). -->
        <activity
            android:name=".PhotoSendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Records a voice note (AAC/m4a) and sends it as an m.audio message;
             started by the tool via StartVoiceNoteSend + startServerActivity. -->
        <activity
            android:name=".VoiceNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Keeps the Matrix sync loop alive in the background. Uses cleartext
             HTTP so a self-hosted LAN homeserver (e.g. 10.0.2.2 in dev) works. -->
        <service
            android:name=".ChatSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- sdk:client merges its UnifiedPush service + file-share provider;
             the companion is a local Matrix server and uses neither. -->
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            tools:node="remove" />
        <provider
            android:name="com.thelightphone.sdk.LightFileProvider"
            tools:node="remove" />

        <!-- sdk:server merges the UnifiedPush distributor (an EXPORTED receiver —
             any app can start the process with it) and the connector's
             receiver/activity/foreground service; the chats companion delivers
             messages via its own sync loop, so strip them all. -->
        <receiver
            android:name="com.thelightphone.sdk.server.LightPushDistributor"
            tools:node="remove" />
        <receiver
            android:name="org.unifiedpush.android.connector.internal.MessagingReceiverImpl"
            tools:node="remove" />
        <activity
            android:name="org.unifiedpush.android.connector.internal.LinkActivity"
            tools:node="remove" />
        <service
            android:name="org.unifiedpush.android.connector.internal.RaiseToForegroundService"
            tools:node="remove" />
    </application>

</manifest>
